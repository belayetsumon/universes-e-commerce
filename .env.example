SPRING_PROFILES_ACTIVE=live
SPRING_DATASOURCE_URL=jdbc:mysql://database.example.internal:3306/universes?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=universes_app
SPRING_DATASOURCE_PASSWORD=replace-with-secret-manager-reference
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
SPRING_FLYWAY_ENABLED=true
# Set true only for the first controlled adoption of an existing non-empty schema.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false

SPRING_MAIL_HOST=smtp.example.internal
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

SMS_API_URL=
SMS_API_KEY=
SMS_SMPP_HOST=
SMS_SMPP_PORT=2775
SMS_SMPP_USER_ID=
SMS_SMPP_PASSWORD=
SMS_SMPP_REQUEST_DELIVERY=true

STORAGE_ROOT_PATH=/opt/tomcat/universesecommerce
